@{
    ViewData["Title"] = "About Us - AutoGems.ai";
}

<div class="max-w-5xl mx-auto px-6 py-16 text-gray-900 leading-normal">

    <header class="mb-20">
        <h1 class="text-4xl font-bold mb-4">AutoGems.ai</h1>
        <h2 class="text-3xl font-extrabold mb-6">Stop Searching. Start Finding Used & Reliable Auto Gems.</h2>
        <p class="text-xl text-gray-600 max-w-3xl">
            We use Agentic AI to scan the market for the only cars worth buying: the ones that are used, reliable, determined by our Agent to be an AutoGem.
        </p>
    </header>

    <section class="mb-24">
        <h3 class="text-2xl font-bold mb-10 border-b pb-4">The Used & Reliable "Gem" Methodology</h3>

        <div class="grid md:grid-cols-3 gap-12">
            <div>
                <h4 class="text-lg font-bold mb-3">Reliability First</h4>
                <p class="text-gray-600">
                    We start with the latest Consumer Reports "Top Picks" and reliability ratings. If it isn't built to last, it isn't on our site.
                </p>
            </div>

            <div>
                <h4 class="text-lg font-bold mb-3">Market Intelligence</h4>
                <p class="text-gray-600">
                    We pull live For Sale By Owner (FSBO) listings data from the internet to see every available listing in your area.
                </p>
            </div>

            <div>
                <h4 class="text-lg font-bold mb-3 text-blue-600">Agentic Analysis</h4>
                <p class="text-gray-600">
                    Our AI agents calculate the "Value Score"—a proprietary mix of price, mileage, and historical depreciation—to find the 1% of cars that are true bargains.
                </p>
            </div>
        </div>
    </section>

    <section class="bg-gray-50 p-10 rounded-2xl mb-16">
        <h3 class="text-2xl font-bold mb-10">Why Used & Reliable?</h3>

        <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
                <h4 class="font-bold mb-3">Avoid the "New Car" Hit</h4>
                <p class="text-sm text-gray-600 leading-relaxed">
                    A new car loses 20% of its value the moment you drive it off the lot. Let someone else take that hit.
                </p>
            </div>

            <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
                <h4 class="font-bold mb-3">Proven Track Record</h4>
                <p class="text-sm text-gray-600 leading-relaxed">
                    By buying models with high Consumer Reports ratings, you are choosing a vehicle with a documented history of staying on the road.
                </p>
            </div>

            <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
                <h4 class="font-bold mb-3">AI-Vetted</h4>
                <p class="text-sm text-gray-600 leading-relaxed">
                    Our agents don't have a quota to fill or a commission to earn. Their only job is to find you the best math-based deal on the internet.
                </p>
            </div>
        </div>
    </section>

    <div class="text-center pt-8">
        <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-10 py-3 rounded font-bold transition-colors">
            Back to Search
        </a>
    </div>

</div>